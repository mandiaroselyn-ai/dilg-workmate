# DILG WorkMate Environment Variables
# API Auth configuration setting if custom routing requires auth security key integrations.
API_AUTH_SECRET="your_production_secret_key_here"

# APP_URL: The primary base URL of the deployed portal application.
# Used for internal link indexing, redirect callbacks, and unified absolute endpoint resolution.
APP_URL="http://localhost:3000"

# MONGODB_URI: MongoDB connection string for production database connectivity.
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/dilg_workmate?retryWrites=true&w=majority
MONGODB_URI="mongodb://localhost:27017/dilg_workmate"
