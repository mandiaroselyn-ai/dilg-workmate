# DILG WorkMate Environment Variables
MONGODB_URI="mongodb://localhost:27017/dilg_workmate"
JWT_SECRET="replace_with_a_long_random_secret"
FRONTEND_URL="http://localhost:5173"
WEBAUTHN_RP_ID="localhost"
# Adobe PDF Embed API Client ID, registered in Adobe for the site's domain, so the form being signed
# shows in Adobe's own viewer. Read when the site is built. WorkMate's own (for
# dilg-workmate.vercel.app) is used when this is empty; set it only for another domain.
VITE_ADOBE_EMBED_CLIENT_ID=""
