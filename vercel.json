{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "vite",
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 30,
      "includeFiles": "node_modules/@vladmandic/face-api/model/{tiny_face_detector_model*,face_landmark_68_model*,face_recognition_model*}"
    },
    "api/face-enrollment.js": {
      "maxDuration": 30,
      "includeFiles": "node_modules/@vladmandic/face-api/model/{tiny_face_detector_model*,face_landmark_68_model*,face_recognition_model*}"
    },
    "api/**/*.js": {
      "maxDuration": 30,
      "includeFiles": "node_modules/@vladmandic/face-api/model/{tiny_face_detector_model*,face_landmark_68_model*,face_recognition_model*}"
    }
  }
}
