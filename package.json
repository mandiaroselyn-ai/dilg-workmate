{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "node --test \"shared/**/*.test.js\" \"src/**/*.test.js\" \"backend/src/**/*.test.js\"",
    "dev": "node scripts/dev.mjs",
    "dev:backend": "node backend/src/index.js",
    "dev:frontend": "cd frontend && npm run dev",
    "test:security": "node --test backend/src/utils/passwordSecurity.test.js backend/src/utils/requestFields.test.js backend/src/utils/mobileAuthHandoff.test.js backend/src/security.integration.test.js",
    "migrate:passwords": "node backend/scripts/hash-legacy-passwords.mjs",
    "build": "vite build && esbuild backend/src/index.js --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "start": "node dist/server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js dist/server.cjs",
    "lint": "echo 'JS/JSX bypass check'",
    "test:integration": "node --test backend/src/security.integration.test.js"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@simplewebauthn/server": "^14.0.3",
    "@tailwindcss/vite": "^4.1.14",
    "@tensorflow/tfjs": "4.22.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vladmandic/face-api": "1.7.15",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jpeg-js": "^0.4.4",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "leaflet.gridlayer.googlemutant": "^0.16.0",
    "lucide-react": "^0.546.0",
    "mongoose": "^9.6.3",
    "nodemailer": "^10.0.12",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pngjs": "^7.0.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tesseract.js": "^7.0.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "supertest": "^7.3.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.2.0"
  }
}
