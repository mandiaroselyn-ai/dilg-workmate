{
  "expo": {
    "name": "DILG Workmate",
    "slug": "dilg-workmate-employee-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "com.dilg.workmate.employee",
    "icon": "./assets/icon.png",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.dilg.workmate",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "extra": {
      "eas": {
        "projectId": "abde18d3-e6af-4c98-b053-32289f2c156c"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 210,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ]
  }
}
