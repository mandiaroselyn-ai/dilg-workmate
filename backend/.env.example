# Backend environment variables for DILG WorkMate
MONGO_URI=mongodb://localhost:27017/dilg_workmate


PORT=5000
JWT_SECRET=your_secret_key_here
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
EMAIL_FROM="DILG WorkMate <no-reply@dilg.gov.ph>"
FRONTEND_URL=http://localhost:5173
WEBAUTHN_RP_ID=localhost
# Time In after this Manila time (24-hour HH:MM) is marked late. Defaults to 08:00.
OFFICE_START_TIME=08:00
NODE_ENV=development
UNISMS_API_KEY=your_unisms_secret_key_here
UNISMS_API_URL=https://unismsapi.com/api/sms
UNISMS_SENDER_ID=UniSMS
UNISMS_WEBHOOK_SECRET=your_unisms_webhook_secret_here
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
GOOGLE_MOBILE_REDIRECT_URI=http://192.168.1.2:5000/api/auth/google/callback
MOBILE_AUTH_REDIRECT_URI=com.dilg.workmate.employee://oauth